<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>IC_ConversionRecord</defName>
    <label>assimilated</label>
    <description>A permanent record of this pawn's assimilation: who they were before the pod and when the body was rebuilt.</description>
    <hediffClass>IdentityCrisis.Hediff_ConversionRecord</hediffClass>
    <defaultLabelColor>(0.75, 0.75, 0.75)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>

  <HediffDef>
    <defName>IC_PhantomDiscomfort</defName>
    <label>old body memory</label>
    <description>The mind still measures the world by the old body: it reaches with hands that are not there, misjudges its own stride and does not recognize the face in the mirror. In newbloods this memory fades in about a month.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.75, 0.6, 0.85)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="IdentityCrisis.HediffCompProperties_FadeToFloor">
        <severityPerDay>-0.034</severityPerDay>
        <floor>0</floor>
      </li>
    </comps>
    <stages>
      <li>
        <label>fading</label>
      </li>
      <li>
        <minSeverity>0.33</minSeverity>
        <label>adapting</label>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.03</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.66</minSeverity>
        <label>strong</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>IC_FormWashShock</defName>
    <label>foreign flesh</label>
    <description>This body was remade against its owner's will. The memories do not fit the new flesh, and the mind keeps recoiling from it. Within about two weeks the shock settles into a chronic phase, the scar of the remaking, which lasts for life.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.4, 0.45)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="IdentityCrisis.HediffCompProperties_FadeToFloor">
        <severityPerDay>-0.035</severityPerDay>
        <floor>0.35</floor>
      </li>
    </comps>
    <stages>
      <li>
        <label>chronic</label>
        <statOffsets>
          <MentalBreakThreshold>0.05</MentalBreakThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>severe</label>
        <statOffsets>
          <MentalBreakThreshold>0.08</MentalBreakThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>acute</label>
        <statOffsets>
          <MentalBreakThreshold>0.12</MentalBreakThreshold>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
        <mentalBreakMtbDays>8</mentalBreakMtbDays>
        <allowedMentalBreakIntensities>
          <li>Minor</li>
          <li>Major</li>
        </allowedMentalBreakIntensities>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>IC_GenderShift</defName>
    <label>gender shift</label>
    <description>The new body is of a different sex than the one this person lived in. Newbloods get used to it in about three weeks. For the remade, the trace never goes away.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.6, 0.7)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="IdentityCrisis.HediffCompProperties_FadeToFloor">
        <severityPerDay>-0.05</severityPerDay>
        <floor>0</floor>
        <forcedFloor>0.3</forcedFloor>
      </li>
    </comps>
    <stages>
      <li>
        <label>lingering</label>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>raw</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>IC_AssimilationRecovery</defName>
    <label>post-assimilation recovery</label>
    <description>The rebuilt body does not obey yet. For about a day after the pod the pawn lies in a coma, then spends two more days in rehabilitation while the mind learns to walk and hold things with the new flesh.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.7, 0.9)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.334</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <label>last day</label>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.33</minSeverity>
        <label>rehabilitation</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.30</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.67</minSeverity>
        <label>coma</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
