<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>IC_AssimilationPod</defName>
    <label>assimilation pod</label>
    <description>A sealed casket filled with nutrient gel and gene-rewriting nanites. Over about a day it dissolves a living body and rebuilds it to the pattern of another humanlike race. Mind, memory and skills survive the process. Those who lie down willingly come out as newbloods; those put inside by force come out remade. Either way, the psyche pays the price. Research assimilation after Electricity, then build this pod from Architect > Misc: 120 steel, 6 industrial components and 4 industrial medicine; construction skill 6. Requires 400 W of power. With Biotech, the default cost is 5 hemogen packs per procedure; without Biotech, no blood is required. Duration, blood cost and medical options can be adjusted in the mod settings.</description>
    <thingClass>IdentityCrisis.Building_AssimilationPod</thingClass>
    <graphicData>
      <texPath>Things/Building/IC_AssimilationPod/IC_AssimilationPod</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,2)</drawSize>
      <shadowData>
        <volume>(0.83, 0.3, 1.7)</volume>
      </shadowData>
    </graphicData>
    <size>(1,2)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(1,0,0)</interactionCellOffset>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.5</fillPercent>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <MedicineIndustrial>4</MedicineIndustrial>
    </costList>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites>
      <li>IC_Assimilation</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <modExtensions>
      <li Class="IdentityCrisis.AssimilationPodExtension">
        <ticksToComplete>60000</ticksToComplete>
        <bloodPacksPerConversion>5</bloodPacksPerConversion>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
